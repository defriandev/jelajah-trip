# Environment (development | test | production)
APP_ENV=development
PORT=8080

# Database Configuration (PostgreSQL)
# Format DATABASE_URL: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres@localhost:5432/jelajah_trip?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=jelajah_trip
DB_SSLMODE=disable

# JWT Authentication
# PENTING: Pada production, JWT_SECRET WAJIB memiliki panjang minimal 32 karakter!
JWT_SECRET=jelajahtrip_super_secret_jwt_key_2026_portfolio_min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=jelajahtrip_refresh_secret_key_2026_portfolio_min32chars
JWT_REFRESH_EXPIRES_IN=168h

# CORS Configuration (pisahkan dengan koma jika lebih dari satu)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse Proxy & Trusted Proxy Configuration (Fase 1.5)
# Set header proxy seperti X-Forwarded-For atau CF-Connecting-IP jika berada di balik reverse proxy / Cloudflare
PROXY_HEADER=X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1
